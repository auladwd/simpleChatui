# ============================================================
# Dockerfile.prod  –  simple-vite-front  (Production)
#
# Purpose : optimised, static-file serving container for
#           staging and production environments
# Stage 1 : node:20-alpine  → npm build (Vite)
# Stage 2 : nginx:1.27-alpine → serve dist/
# Port    : 80
# ============================================================

# ---- Stage 1: Build ----
FROM node:20-alpine AS builder

WORKDIR /app

# Copy dependency manifests and install
COPY package.json yarn.lock* package-lock.json* ./
RUN if [ -f yarn.lock ]; then yarn install --frozen-lockfile; \
    else npm ci; fi

# Copy source and build
COPY . .

# VITE_ env vars must be provided at build time via --build-arg
ARG VITE_API_URL
ARG VITE_SOCKET_URL
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_SOCKET_URL=$VITE_SOCKET_URL

RUN npm run build

# ---- Stage 2: Serve with Nginx ----
FROM nginx:1.27-alpine AS production

# Remove default nginx config and replace with ours
RUN rm /etc/nginx/conf.d/default.conf
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy built assets from builder
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

# nginx runs as PID 1; drop privileges inside nginx config
CMD ["nginx", "-g", "daemon off;"]
